          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(recall_agent_iterations_bucket{namespace=\"$namespace\", job=\"tutor-agent\"}[10m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(recall_agent_iterations_bucket{namespace=\"$namespace\", job=\"tutor-agent\"}[10m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "description": "Model calls per agent run. A normal tutoring turn is 1-3; the cap is 8. p95 climbing toward 8 means the ReAct loop is not converging -- usually a tool erroring in a loop, which RecallAgentCapped alerts on."
    },
