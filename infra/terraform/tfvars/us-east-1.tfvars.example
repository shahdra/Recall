# Recall — us-east-1 variable values.
#
# Copy to us-east-1.tfvars before use:
#   cp tfvars/us-east-1.tfvars.example tfvars/us-east-1.tfvars
#
# The .example suffix is not because this file holds secrets — it holds none, and
# every value below is safe to commit. It is because .gitignore:34 ignores *.tfvars
# with only an `!*.tfvars.example` exception, so a file named us-east-1.tfvars would
# be silently untracked. (The fix is a one-line ignore change; it has been raised
# rather than made as a side effect of this work.)
#
# WORKSPACE MUST MATCH REGION. The workspace names the region, so:
#
#   terraform workspace select us-east-1   # or `new` the first time
#   terraform plan -var-file=tfvars/us-east-1.tfvars
#
# A mismatch is caught by the precondition on terraform_data.workspace_region_guard
# in main.tf rather than silently building a second, misnamed set of tables.

region = "us-east-1"

# Prefix for every resource name and the Owner tag. The course AWS account is
# shared, so this is what prevents a collision with a classmate's "Cards" table.
owner = "shahdra"

# Prepended to the three table names. Set to "" only for a throwaway stack where
# the bare names Cards/Decks/LearnerProfile are known to be free.
table_name_prefix = "shahdra-recall-"

# Days before an archived upload is expired from S3. The generated cards live in
# DynamoDB and are unaffected.
uploads_retention_days = 90

# Continuous backups for the three tables. Off for a course project whose data can
# be regenerated by re-uploading material; turn on if a demo's review history
# becomes worth protecting.
point_in_time_recovery = false

# ===========================================================================
# Cluster
# ===========================================================================

# Name of an EC2 key pair that ALREADY EXISTS in this region. Terraform does not
# create it (the private half would land in state). This is the only variable with
# no default — see variables.tf for the create-key-pair command.
ssh_key_name = "shahd-key"

# Local path to the matching private key. Terraform never reads it; it only makes
# the ssh_command / fetch_kubeconfig_command outputs paste-ready.
ssh_private_key_path = "~/.ssh/shahd-key.pem"

# Who may reach SSH (22) and the Kubernetes API (6443). 0.0.0.0/0 is a real
# exposure and a deliberate one: both ports still require credentials (key pair,
# client cert), and a stale CIDR here locks you out of a cluster that cannot yet be
# reached any other way. Narrow it if your address is stable:
#   ssh_ingress_cidr = "203.0.113.4/32"   # curl -s https://checkip.amazonaws.com
ssh_ingress_cidr = "0.0.0.0/0"

# Network. vpc_cidr must not overlap pod_network_cidr.
vpc_cidr         = "10.0.0.0/16"
pod_network_cidr = "192.168.0.0/16"

# Kubernetes MINOR version — selects the pkgs.k8s.io apt repo. "v1.30.4" would 404.
kubernetes_version = "v1.30"

# Sizing. Two t3.medium instances is the whole hourly cost of this stack; the data
# plane is nearly free at rest. Set worker_desired_capacity = 0 to stop the worker
# billing without destroying (the control plane keeps running).
control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.medium"
worker_desired_capacity     = 1

# 30 GiB, not Ubuntu's 8 GiB default — container images fill 8 GiB and the kubelet
# responds to a full disk by evicting pods, not by failing loudly.
root_volume_size = 30
