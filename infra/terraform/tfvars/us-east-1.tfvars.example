# Recall — us-east-1 variable values.
#
# Copy to us-east-1.tfvars before use:
#   cp tfvars/us-east-1.tfvars.example tfvars/us-east-1.tfvars
#
# The .example suffix is not because this file holds secrets — it holds none, and
# every value below is safe to commit. It is because .gitignore:34 ignores *.tfvars
# with only an `!*.tfvars.example` exception, so a file named us-east-1.tfvars would
# be silently untracked. (The fix is a one-line ignore change; it has been raised
# rather than made as a side effect of this work.)
#
# WORKSPACE MUST MATCH REGION. The workspace names the region, so:
#
#   terraform workspace select us-east-1   # or `new` the first time
#   terraform plan -var-file=tfvars/us-east-1.tfvars
#
# A mismatch is caught by the precondition on terraform_data.workspace_region_guard
# in main.tf rather than silently building a second, misnamed set of tables.

region = "us-east-1"

# Prefix for every resource name and the Owner tag. The course AWS account is
# shared, so this is what prevents a collision with a classmate's "Cards" table.
owner = "shahdra"

# Prepended to the three table names. Set to "" only for a throwaway stack where
# the bare names Cards/Decks/LearnerProfile are known to be free.
table_name_prefix = "shahdra-recall-"

# Days before an archived upload is expired from S3. The generated cards live in
# DynamoDB and are unaffected.
uploads_retention_days = 90

# Continuous backups for the three tables. Off for a course project whose data can
# be regenerated by re-uploading material; turn on if a demo's review history
# becomes worth protecting.
point_in_time_recovery = false
